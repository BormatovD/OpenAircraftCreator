# Deploy with init-server.sh, replacing aircraft-designer.app.
# Static Vite single-HTML build. No backend, database or Node process on VPS.
aircraft-designer.app {
    root * /srv/aircraft-designer/current
    encode zstd gzip
    @html path / *.html /release-id.txt
    header @html Cache-Control "no-store, max-age=0"
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
    # Public, versioned preset table; permit FlightCost to read it without a proxy.
    @fc_catalog path /aircraft-configurations.v1.json
    header @fc_catalog Access-Control-Allow-Origin "https://flightcost.app"
    header @fc_catalog Vary "Origin"
    # Aircraft Designer may be embedded only on the trusted FlightCost origin.
    header Content-Security-Policy "frame-ancestors 'self' https://flightcost.app"
    file_server
}
